GOOGLE_GEMINI_API_KEY=AIzaSyA41XhiQfydhYVYVO_-ByfFds7_cHp8uyA
GOOGLE_GEMINI_MODEL=models/gemini-2.5-flash
GOOGLE_MAPS_API_KEY=AIzaSyByScI4R0fNVQkChuOxNLcDDabeh7lb1iw
# Set to false to skip the Google Maps Distance Matrix API call entirely.
# Travel times will be estimated from straight-line (haversine) distance only;
# no real-time traffic data will be fetched or billed.
GOOGLE_MAPS_TRAFFIC_ENABLED=false

# Frontend visualization: number of pickup lanes (1 = single lane, 2 = dual lane)
VITE_PICKUP_LANES=1

# School coordinates (written by assistant)
SCHOOL_LAT=25.763762
SCHOOL_LNG=-100.457603
# Maximum distance (km) for seeded parents
MAX_PARENT_DISTANCE_KM=3.0

# Pickup lane physical parameters (used to compute theoretical throughput)
PICKUP_ROAD_LENGTH_M=20
PICKUP_SPEED_LIMIT_KMH=20
CHILD_PICKUP_TIME_S=10

# Maximum time (minutes) the entire pickup session should take, from the first
# car arriving to the last car departing.  The scheduler uses this as a hard
# deadline: arrival_spacing = min(throughput-based, period-budget / N).
# Set to 0 to disable the period constraint.
# When the session floor exceeds this value (too many parents for the lane),
# the scheduler automatically ignores the period constraint and runs at natural
# throughput pace — missing the SLA is acceptable in that case.
PICKUP_PERIOD_MIN=5

# Simulation speed override for inter-car arrival spacing.
# When > 0: cars arrive at the scanner every SIM_ARRIVAL_SPACING_S seconds,
# bypassing the physics-based floor (~16 s for the default lane config).
# Set to 0 (default) to use throughput-based spacing.
# Example: SIM_ARRIVAL_SPACING_S=1  → one new car every second
SIM_ARRIVAL_SPACING_S=1

# Number of parents to seed for testing
NUM_PARENTS=300

# Seeding: target route distance and urban road tortuosity factor
# Parents are placed so their driving route = SEED_TARGET_ROUTE_KM (±SEED_ROUTE_SPREAD_KM)
# Tortuosity: road distance ÷ straight-line distance (urban ~1.3, suburban ~1.2)
SEED_TARGET_ROUTE_KM=2.5
SEED_ROUTE_TORTUOSITY=1.3
SEED_ROUTE_SPREAD_KM=0.2

